<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      背景整幅朱红、前景只留深墨剪影。
      以前背景是米白 + 一层 80dp 红圆，圆形桌面图标下红圆之外会露出米白边；
      而自适应图标安全区只有 66dp，缩小红圆只会让白边更明显。
      铺满同色背景后，圆形/方形/圆角矩形任何蒙版都不会再出现白边。
    -->
    <background android:drawable="@color/icon_cinnabar" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
